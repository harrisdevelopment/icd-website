# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Where proposal requests are delivered
CONTACT_TO_EMAIL=r.fuentes@inncd.com

# Sender. Use "ICD Website <website@inncd.com>" once inncd.com is verified in Resend.
# Until then use Resend's test sender below, and point CONTACT_TO_EMAIL at a test inbox.
CONTACT_FROM_EMAIL="ICD Website <onboarding@resend.dev>"

# Shared secret for the chat agent's lead webhook (POST /api/lead). Generate a long random
# string, set it here AND as a header on the ElevenLabs agent's submit_lead tool
# (header name: x-lead-secret). The chat widget only appears on the site when this is set.
LEAD_WEBHOOK_SECRET=
